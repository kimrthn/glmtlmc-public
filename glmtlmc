def probe_environment(prefix, icd_path):
    env = dict(os.environ)
    env.update({
        "DYLD_INSERT_LIBRARIES": prefix + "/lib/libgl_interpose.dylib",
        "DYLD_LIBRARY_PATH": prefix + "/lib",
        "LIBGL_DRIVERS_PATH": prefix + "/lib/dri",
        "VK_DRIVER_FILES": icd_path,
        "VK_ICD_FILENAMES": icd_path,
        "EGL_PLATFORM": "surfaceless",
        "MESA_LOADER_DRIVER_OVERRIDE": "zink",
        "MESA_GL_VERSION_OVERRIDE": "4.6",
        "MESA_GLSL_VERSION_OVERRIDE": "460",
        "MESA_VULKAN_LIBRARY": prefix + "/lib/libvulkan.1.dylib",
    })
    return env


def run_translation_probe(prefix, icd_path):
    snippet = PROBE_CODE.replace("__PREFIX__", prefix)
    try:
        completed = subprocess.run(
            [sys.executable, "-c", snippet],
            env=probe_environment(prefix, icd_path),
            capture_output=True, text=True, timeout=PROBE_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise PhaseError("Translation Layer probe timed out after 20 seconds")
    if completed.returncode != 0:
        stderr = completed.stderr.strip()
        raise PhaseError(stderr if stderr
                         else "probe exited with code " + str(completed.returncode))
    return [line for line in completed.stdout.strip().splitlines() if line]


def verify_hardware(line):
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        raise PhaseError("this stack requires Apple Silicon macOS")


def verify_instance_version(line, instance_dir):
    pack_path = os.path.join(instance_dir, "mmc-pack.json")
    with open(pack_path, "r", encoding="utf-8") as handle:
        pack = json.load(handle)
    components = pack.get("components", []) if isinstance(pack, dict) else []
    version = None
    for component in components:
        if isinstance(component, dict) and component.get("uid") == "net.minecraft":
            version = component.get("version") or component.get("cachedVersion")
            break
    if version != MINECRAFT_VERSION:
        raise PhaseError("instance is " + str(version or "missing")
                         + ", expected " + MINECRAFT_VERSION)


def probe_report(line, script_dir, stack):
    prefix = resolve_mesa_prefix(script_dir)
    egl_path = os.path.join(prefix, "lib", "libEGL.dylib")
    if not os.path.isfile(egl_path):
        raise PhaseError(egl_path + " not found (set GLMTLMC_MESA_PREFIX)")
    icd = find_vulkan_icd(prefix)
    if icd is None:
        raise PhaseError("no usable Vulkan ICD found under " + prefix)
    for report_line in run_translation_probe(prefix, icd[0]):
        line.detail(report_line)
    stack["prefix"] = prefix
    stack["icd_path"] = icd[0]
    stack["icd_api_version"] = icd[1]


def configure_mesa(line, stack):
    prefix = stack["prefix"]
    for required in (
        os.path.join(prefix, "lib", "libEGL.dylib"),
        os.path.join(prefix, "lib", "libGL.dylib"),
        os.path.join(prefix, "lib", "libgl_interpose.dylib"),
    ):
        if not os.path.isfile(required):
            raise PhaseError(required + " not found")
    dri_dir = os.path.join(prefix, "lib", "dri")
    if not os.path.isdir(dri_dir) or not os.listdir(dri_dir):
        raise PhaseError(dri_dir + " not found or empty")
    line.detail(prefix)


def configure_kosmickrisp(line, stack):
    line.detail(stack["icd_path"] + " (api_version " + stack["icd_api_version"] + ")")


def link_translation_layer(line, script_dir, stack):
    glfw_path = find_glfw_dylib(script_dir)
    if glfw_path is None:
        raise PhaseError("patched GLFW dylib not found (set GLMTLMC_GLFW_LIB)")
    if " " in glfw_path:
        raise PhaseError("glmtlmc requires a space-free path (current: " + glfw_path + ")")
    if not is_macho(glfw_path):
        raise PhaseError("not a Mach-O dylib: " + glfw_path)
    line.detail(glfw_path)
    stack["glfw_path"] = glfw_path


def configure_custom_arguments(line, instance_dir, stack):
    values = build_patch_values(stack["prefix"], stack["glfw_path"], stack["icd_path"])
    cfg_path = os.path.join(instance_dir, "instance.cfg")
    content = read_file_bytes(cfg_path)
    if not is_already_patched(content):
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        with open(os.path.join(instance_dir, "instance.cfg.glmtlmc.bak-" + stamp), "wb") as handle:
            handle.write(content)
    write_atomically(cfg_path, upsert_ini_keys(content, values))


def verify_startup(line, instance_dir, stack):
    values = build_patch_values(stack["prefix"], stack["glfw_path"], stack["icd_path"])
    current = dict(iter_key_values(read_file_bytes(os.path.join(instance_dir, "instance.cfg"))))
    for key, expected in values.items():
        if current.get(key) != expected:
            raise PhaseError(key + " does not match the value written by glmtlmc")
    for path in stack_paths(stack):
        if not os.path.exists(path):
            raise PhaseError(path + " not found")
    line.detail("instance.cfg verified, all stack paths exist")


def do_nothing(line):
    pass


def verify_instance_state(line, instance_dir):
    cfg_path = os.path.join(instance_dir, "instance.cfg")
    if not is_already_patched(read_file_bytes(cfg_path)):
        raise PhaseError("instance is not patched")


def locate_backup(line, instance_dir, state):
    backups = glob.glob(os.path.join(instance_dir, "instance.cfg.glmtlmc.bak-*"))
    if not backups:
        raise PhaseError("no backup found — cannot restore automatically")
    state["backup_path"] = max(backups)
    line.detail(os.path.basename(state["backup_path"]))


def restore_configuration(line, instance_dir, state):
    cfg_path = os.path.join(instance_dir, "instance.cfg")
    backup_content = read_file_bytes(state["backup_path"])
    current_content = read_file_bytes(cfg_path)
    write_atomically(cfg_path, restore_ini_keys(current_content, backup_content))


def verify_vanilla_startup(line, instance_dir, state):
    cfg_path = os.path.join(instance_dir, "instance.cfg")
    current = dict(iter_key_values(read_file_bytes(cfg_path)))
    backup = dict(iter_key_values(read_file_bytes(state["backup_path"])))
    for key in STACK_KEYS:
        if current.get(key) != backup.get(key):
            raise PhaseError(key + " does not match the backup state")


def patch_phases(instance_dir, script_dir):
    stack = {}
    return [
        ("Verifying hardware compatibility", lambda line: verify_hardware(line)),
        ("Verifying instance version", lambda line: verify_instance_version(line, instance_dir)),
        ("Getting report from Translation Layer", lambda line: probe_report(line, script_dir, stack)),
        ("Configuring MESA", lambda line: configure_mesa(line, stack)),
        ("Configuring KosmikKrisp", lambda line: configure_kosmickrisp(line, stack)),
        ("Linking Translation Layer", lambda line: link_translation_layer(line, script_dir, stack)),
        ("Configuring Custom Arguments", lambda line: configure_custom_arguments(line, instance_dir, stack)),
        ("Verifying instance startup", lambda line: verify_startup(line, instance_dir, stack)),
        ("Cleaning up", do_nothing),
        ("Finalizing", do_nothing),
    ]


def unpatch_phases(instance_dir):
    state = {}
    return [
        ("Verifying instance state", lambda line: verify_instance_state(line, instance_dir)),
        ("Locating original configuration", lambda line: locate_backup(line, instance_dir, state)),
        ("Restoring launch configuration", lambda line: restore_configuration(line, instance_dir, state)),
        ("Verifying vanilla startup", lambda line: verify_vanilla_startup(line, instance_dir, state)),
        ("Cleaning up", do_nothing),
        ("Finalizing", do_nothing),
    ]


def run_operation(phases):
    for title, action in phases:
        line = PhaseLine(title)
        try:
            action(line)
        except (PhaseError, OSError) as failure:
            line.fail(str(failure))
            return 1
        line.done()
    return 0


def print_finish(started, error_count):
    elapsed = time.monotonic() - started
    seconds = int(elapsed)
    milliseconds = int((elapsed - seconds) * 1000)
    print("Finished in " + str(seconds) + ":" + str(milliseconds))
    if error_count:
        print(RED + "Errors: " + str(error_count) + RESET)
    else:
        print(GREEN + "No errors" + RESET)


def ensure_inside_project():
    """Signature-check the folder around the script, then work from inside it.

    Double-clicked runs start with cwd=$HOME, so any starting directory is fine
    as long as the script sits next to README.md (a lone copied script is not).
    """
    script_dir = os.path.dirname(os.path.realpath(__file__))
    if not os.path.isfile(os.path.join(script_dir, "README.md")):
        print(RED + "Error: run the script inside glmtlmc folder" + RESET)
        sys.exit(1)
    os.chdir(script_dir)
    return script_dir


def refuse_if_launcher_running():
    """Refuse while Prism or a launched instance is live: Prism keeps the
    instance settings in memory, so it would both launch stale config and
    overwrite the patch on instance close."""
    for check in (("pgrep", "-i", "prismlauncher"), ("pgrep", "-f", "java-runtime")):
        found = subprocess.run(check, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, check=False)
        if found.returncode == 0:
            print(RED + "Error: quit Prism Launcher (and any running instance)"
                  + " first, then run glmtlmc again" + RESET)
            sys.exit(1)


def ask_instance_location():
    print("Location of the instance?")
    try:
        raw = input()
    except EOFError:
        print(RED + "Error: no instance location given" + RESET)
        sys.exit(1)
    path = os.path.expanduser(strip_surrounding_quotes(raw.strip()))
    if not os.path.isdir(path):
        print(RED + "Error: directory not found: " + path + RESET)
        sys.exit(1)
    for required in ("instance.cfg", "mmc-pack.json"):
        if not os.path.isfile(os.path.join(path, required)):
            print(RED + "Error: " + required + " not found in " + path + RESET)
            sys.exit(1)
    return path


def ask_operation():
    print("1 : Patch")
    print("2 : Unpatch")
    print("3 : Update glmtlmc")
    try:
        choice = input().strip().lower()
    except EOFError:
        choice = ""
    if choice in ("1", "patch"):
        return "patch"
    if choice in ("2", "unpatch"):
        return "unpatch"
    if choice in ("3", "update"):
        return "patch"
    print(RED + "Error: unknown choice" + RESET)
    sys.exit(1)


def main():
    script_dir = ensure_inside_project()
    refuse_if_launcher_running()
    instance_dir = ask_instance_location()
    operation = ask_operation()
    if operation == "unpatch":
        phases = unpatch_phases(instance_dir)
    else:
        phases = patch_phases(instance_dir, script_dir)
    dequarantine(script_dir)
    started = time.monotonic()
    error_count = run_operation(phases)
    print_finish(started, error_count)
    sys.exit(1 if error_count else 0)


def pause_before_exit():
    """Double-click UX: keep the Terminal window open until the user reads it.

    Piped/automated runs (either stream not a TTY) must exit without pausing.
    """
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return
    print()
    print("Press Enter to exit...")
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        pass


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        if ACTIVE_LINE is not None:
            ACTIVE_LINE._wind_down()
        print()
        sys.exit(130)
    finally:
        pause_before_exit()
