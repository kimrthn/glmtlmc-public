class PhaseError(Exception):
    """A phase failure with a message shown to the user."""


class PhaseLine:
    """One phase: its title, the rows beneath it, and its failure.

    Every phase prints its title as it starts, so a row always lands under the
    heading it belongs to and a run that stops reads as a transcript ending at
    the phase that broke.
    """

    def __init__(self, title):
        self.title = title
        print(title)

    def detail(self, message):
        """One indented row of prose under the title."""
        print(INDENT + message)

    def report(self, verb, detail):
        """One indented row saying what happened to what: verb, then the subject."""
        print(INDENT + verb.ljust(VERB_WIDTH) + detail)

    def fail(self, reason):
        """The indented error under the title that failed."""
        print(RED + INDENT + "error: " + reason + RESET)


def is_macho(path):
    macho_magics = (
        b"\xcf\xfa\xed\xfe", b"\xfe\xed\xfa\xcf",
        b"\xce\xfa\xed\xfe", b"\xfe\xed\xfa\xce",
        b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca",
    )
    with open(path, "rb") as handle:
        return handle.read(4) in macho_magics


def read_exactly(handle, count, path):
    """`count` bytes, or a PhaseError naming the file that ran out.

    A short read is the one shape a malformed image always takes, and it must be
    an error rather than a struct.error traceback.
    """
    chunk = handle.read(count)
    if len(chunk) != count:
        raise PhaseError(path + " ends " + str(count - len(chunk))
                         + " bytes early, where a Mach-O structure should be")
    return chunk


def arm64_slice_offset(handle, path):
    """Where the arm64 slice starts in an open Mach-O; 0 for a thin image.

    A universal file is a big-endian count of slice records, a thin one a
    little-endian header at the front. Anything else is a parse error: a reader
    that guesses here would go on to report a section size for the wrong bytes.
    """
    magic = read_exactly(handle, MACHO_MAGIC_BYTES, path)
    if magic != FAT_MAGIC_BYTES:
        if struct.unpack("<I", magic)[0] != MH_MAGIC_64:
            raise PhaseError(path + " is not a 64-bit Mach-O image")
        if struct.unpack("<I", read_exactly(handle, MACHO_CPUTYPE_BYTES, path))[0] != CPU_TYPE_ARM64:
            raise PhaseError(path + " is not an arm64 Mach-O image")
        return 0
    entries = struct.unpack(">I", read_exactly(handle, MACHO_COUNT_BYTES, path))[0]
    for _ in range(entries):
        record = read_exactly(handle, MACHO_SLICE_BYTES, path)
        cputype, _subtype, offset, _size, _align = struct.unpack(">iiIII", record)
        if cputype == CPU_TYPE_ARM64:
            return offset
    raise PhaseError(path + " is a universal binary with no arm64 slice")


def interpose_section_size(path):
    """Byte size of __interpose in a Mach-O, read from its own load commands.

    The VR fix lives or dies on this number: 25 tuples of 16 bytes is a real
    redirection table, 16 bytes is a single tuple, which is what a build emits
    when each trampoline took the name of the symbol it displaces. Read here in
    Python rather than parsed out of otool's prose, and never assumed — a file
    that cannot be read is an error, not a default.
    """
    with open(path, "rb") as handle:
        handle.seek(arm64_slice_offset(handle, path))
        header = read_exactly(handle, MACHO_HEADER_BYTES, path)
        commands = struct.unpack_from("<I", header, MACHO_NCMDS_OFFSET)[0]
        for _ in range(commands):
            prologue = read_exactly(handle, MACHO_COMMAND_BYTES, path)
            command, size = struct.unpack("<2I", prologue)
            if size < MACHO_COMMAND_BYTES:
                raise PhaseError(path + " declares a " + str(size) + "-byte load command")
            body = read_exactly(handle, size - MACHO_COMMAND_BYTES, path)
            if command != LC_SEGMENT_64 or len(body) < SEGMENT_SECTIONS_OFFSET:
                continue
            section_count = struct.unpack_from("<I", body, SEGMENT_SECTCOUNT_OFFSET)[0]
            for index in range(section_count):
                start = SEGMENT_SECTIONS_OFFSET + index * SECTION_64_BYTES
                section = body[start:start + SECTION_64_BYTES]
                if len(section) != SECTION_64_BYTES:
                    raise PhaseError(path + " declares a section table it does not carry")
                name = section[:SECTION_NAME_BYTES].split(b"\0")[0].decode("utf-8", "replace")
                if name == "__interpose":
                    return struct.unpack_from("<Q", section, SECTION_SIZE_OFFSET)[0]
    raise PhaseError(path + " carries no __interpose section")


def nm_symbols(path):
    """{symbol name: nm type letter} for every symbol in an arm64 dylib."""
    completed = run_tool(["xcrun", "nm", "-arch", "arm64", path])
    if completed.returncode != 0:
        raise PhaseError("nm could not read " + path
                         + " (" + (completed.stderr.strip() or str(completed.returncode)) + ")")
    symbols = {}
    for row in completed.stdout.splitlines():
        fields = row.split()
        if len(fields) == 3 and fields[0][0] in HEX_DIGITS:
            symbols[fields[2]] = fields[1]
        elif len(fields) == 2:
            symbols[fields[1]] = fields[0]
    return symbols


def is_code_signed(path):
    """Whether dyld will load the image: codesign must find a signature."""
    return run_tool(["codesign", "-dv", path]).returncode == 0


def read_file_bytes(path):
    with open(path, "rb") as handle:
        return handle.read()


def write_atomically(line, path, content):
    """The one write path every config goes through, so the bytes and the report agree.

    The staged file never survives the call, so the row names the path a reader
    will actually find rather than the temporary one.
    """
    temporary = path + TEMP_SUFFIX
    with open(temporary, "wb") as handle:
        handle.write(content)
    os.replace(temporary, path)
    line.report("wrote", path)


def strip_surrounding_quotes(text):
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        return text[1:-1]
    return text


def iter_key_values(content):
    """Yield (key, value) for each `key=value` line, split on the first `=`."""
    for line in content.decode("utf-8", "surrogateescape").splitlines():
        if line.lstrip().startswith(("[", "#")):
            continue
        key, separator, value = line.partition("=")
        if separator:
            yield key, value


def is_already_patched(content):
    for key, value in iter_key_values(content):
        if key == "WrapperCommand" and "libgl_interpose" in value \
                and "MESA_LOADER_DRIVER_OVERRIDE=zink" in value:
            return True
    return False


def general_section_bounds(lines):
    """(start, end) of the [General] section, end exclusive; None if missing."""
    start = None
    for index, line in enumerate(lines):
        if line.strip() == "[General]":
            start = index
            break
    if start is None:
        return None
    for index in range(start + 1, len(lines)):
        if lines[index].lstrip().startswith("["):
            return start, index
    return start, len(lines)


def find_key_line(lines, key, start, end):
    for index in range(start + 1, end):
        candidate, separator, _ = lines[index].partition("=")
        if separator and candidate.rstrip("\r") == key:
            return index
    return None


def last_key_line_index(lines, start, end):
    """Index of the last `key=value` line in the section; the header if none."""
    last = start
    for index in range(start + 1, end):
        line = lines[index]
        if "=" in line and not line.lstrip().startswith("#"):
            last = index
    return last


def line_ending(line):
    if line.endswith("\r\n"):
        return "\r\n"
    if line.endswith(("\n", "\r")):
        return line[-1:]
    return ""


def upsert_ini_keys(content, values):
    """Set each `key=value` inside [General], preserving every other byte."""
    lines = content.decode("utf-8", "surrogateescape").splitlines(keepends=True)
    for key, value in values.items():
        bounds = general_section_bounds(lines)
        if bounds is None:
            raise PhaseError("instance.cfg has no [General] section")
        start, end = bounds
        index = find_key_line(lines, key, start, end)
        if index is not None:
            lines[index] = key + "=" + value + line_ending(lines[index])
        else:
            anchor = last_key_line_index(lines, start, end)
            if not lines[anchor].endswith(("\n", "\r")):
                lines[anchor] += "\n"
            lines.insert(anchor + 1, key + "=" + value + "\n")
    return "".join(lines).encode("utf-8", "surrogateescape")


def remove_ini_keys(content, keys):
    """Drop every `key=value` line whose key is in `keys`; keep all else."""
    lines = content.decode("utf-8", "surrogateescape").splitlines(keepends=True)
    kept = []
    for line in lines:
        candidate, separator, _ = line.partition("=")
        if separator and candidate.rstrip("\r") in keys:
            continue
        kept.append(line)
    return "".join(kept).encode("utf-8", "surrogateescape")


def restore_ini_keys(current_content, backup_content):
    """Return current content with the 4 stack keys set to the backup state."""
    backup_values = dict(iter_key_values(backup_content))
    present = {key: backup_values[key] for key in STACK_KEYS if key in backup_values}
    absent = [key for key in STACK_KEYS if key not in backup_values]
    content = upsert_ini_keys(current_content, present)
    return remove_ini_keys(content, absent)


def without_line_ending(text):
    """text less its trailing terminator, so it compares like an iter_key_values value."""
    ending = line_ending(text)
    return text if not ending else text[:-len(ending)]


def general_key_values(content):
    """{key: value} for the keys in [General], the section upsert_ini_keys writes.

    First line wins, the same rule find_key_line applies, and the terminator comes
    off, the same rule iter_key_values applies: a report built from this cannot
    disagree with the write that follows it.
    """
    lines = content.decode("utf-8", "surrogateescape").splitlines(keepends=True)
    bounds = general_section_bounds(lines)
    if bounds is None:
        return {}
    start, end = bounds
    values = {}
    for index in range(start + 1, end):
        key, separator, value = lines[index].partition("=")
        if separator:
            values.setdefault(key.rstrip("\r"), without_line_ending(value))
    return values


def set_verdicts(current, values):
    """(verb, detail) per key in values, in config order: set, or kept as it was."""
    verdicts = []
    for key, value in values.items():
        if current.get(key) == value:
            verdicts.append(("kept", key + " (already correct)"))
        else:
            verdicts.append(("set", key))
    return verdicts


def restore_verdicts(current_content, backup_content):
    """(verb, detail) per stack key: restored, dropped, or already as backed up.

    A key the backup never had is a key glmtlmc added, so unpatching removes it.
    """
    backed_up = dict(iter_key_values(backup_content))
    present = general_key_values(current_content)
    verdicts = []
    for key in STACK_KEYS:
        if key not in backed_up:
            if key in present:
                verdicts.append(("removed", key))
            continue
        if present.get(key) == backed_up[key]:
            verdicts.append(("kept", key + " (already as backed up)"))
        else:
            verdicts.append(("restored", key))
    return verdicts


def resolve_mesa_prefix(script_dir):
    """Environment override, then the stack shipped next to the script, then ~/mesa-native."""
    explicit = os.environ.get("GLMTLMC_MESA_PREFIX")
    if explicit:
        return os.path.abspath(explicit)
    stack_prefix = os.path.join(script_dir, "stack")
    if os.path.isfile(os.path.join(stack_prefix, "lib", "libEGL.dylib")):
        return os.path.abspath(stack_prefix)
    return os.path.abspath(os.path.expanduser("~/mesa-native"))


def find_vulkan_icd(prefix):
    """First Vulkan ICD (sorted) whose library exists; (path, api_version) or None."""
    explicit = os.environ.get("GLMTLMC_ICD")
    if explicit:
        candidates = [explicit]
    else:
        candidates = sorted(glob.glob(
            os.path.join(prefix, "share", "vulkan", "icd.d", "*.json")))
    for candidate in candidates:
        try:
            with open(candidate, "r", encoding="utf-8") as handle:
                manifest = json.load(handle)
            library = manifest["ICD"]["library_path"]
            api_version = manifest["ICD"].get("api_version", "unknown")
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if not os.path.isabs(library):
            library = os.path.join(os.path.dirname(candidate), library)
        if os.path.isfile(library):
            return candidate, api_version
    return None


def find_glfw_dylib(script_dir):
    explicit = os.environ.get("GLMTLMC_GLFW_LIB")
    if explicit:
        candidates = [explicit]
    else:
        candidates = [
            os.path.join(script_dir, "stack", "lib", "libglfw.3.dylib"),
            os.path.join(script_dir, "..", "GL46-Exp", "glfw", "build", "src", "libglfw.3.dylib"),
            os.path.join(script_dir, "glfw", "build", "src", "libglfw.3.dylib"),
            os.path.join(script_dir, "..", "glfw", "build", "src", "libglfw.3.dylib"),
        ]
    for candidate in candidates:
        if os.path.isfile(candidate):
            return os.path.abspath(candidate)
    return None


def quarantined_count(folder):
    """How many paths under folder carry the quarantine attribute right now.

    xattr says nothing when it strips the attribute, so the count has to come
    from asking before stripping: a report line has to be able to say "0 files"
    and be right.
    """
    listing = subprocess.run(["xattr", "-r", folder],
                             capture_output=True, text=True, check=False)
    suffix = ": " + QUARANTINE_ATTR
    return sum(1 for row in listing.stdout.splitlines() if row.endswith(suffix))


def plural(count, noun):
    return str(count) + " " + noun + ("" if count == 1 else "s")


def dequarantine(script_dir):
    """Strip Gatekeeper quarantine from the shipped stack and shaderpacks.

    Undoing a quarantine edits the extended attributes of every file it touches,
    so it is reported the same way as a write even though nothing was rewritten.
    """
    cleared = []
    for folder in ("stack", "shaderpacks"):
        target = os.path.join(script_dir, folder)
        if not os.path.isdir(target):
            continue
        cleared.append((folder, quarantined_count(target)))
        subprocess.run(
            ["xattr", "-dr", QUARANTINE_ATTR, target],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    if not cleared:
        return
    line = PhaseLine("Clearing quarantine")
    for folder, count in cleared:
        line.report("cleared", folder + " (" + plural(count, "file") + ")")


def run_tool(command, timeout=None):
    """One developer tool, output captured; a tool that is not there is a failure."""
    try:
        return subprocess.run(command, capture_output=True, text=True,
                              check=False, timeout=timeout)
    except OSError as failure:
        raise PhaseError("cannot run " + command[0] + " (" + str(failure) + ")"
                         + " — the Xcode command line tools must be installed")


def jvm_arg_tokens(content):
    """The flags Prism will hand the JVM, tokenised out of the JvmArgs value."""
    jvm_args = dict(iter_key_values(content)).get("JvmArgs", "")
    return strip_surrounding_quotes(jvm_args).split()


def wrapper_env_pairs(content):
    """The WrapperCommand's `env` assignments, as (name, value) pairs."""
    command = dict(iter_key_values(content)).get("WrapperCommand", "")
    pairs = []
    for token in strip_surrounding_quotes(command).split():
        name, separator, value = token.partition("=")
        if separator:
            pairs.append((name, value))
    return pairs


def moltenvr_jvm_flags(content):
    """MoltenVR's own JvmArgs flags, in place and without duplicates.

    Its "Enable VR" button writes them into the same JvmArgs line glmtlmc owns,
    so a plain patch run would delete them. No flags means no-op.
    """
    flags = []
    for token in jvm_arg_tokens(content):
        if token.startswith(MOLTENVR_JVM_FLAGS) and token not in flags:
            flags.append(token)
    return flags


def preserved_vr_glfix(content):
    """The libvr_glfix.dylib path the instance already injects, or None.

    glmtlmc rewrites WrapperCommand wholesale, so without this the VR fix a user
    deployed by hand would be dropped by a plain patch and the VR segfault would
    come back with nothing to say what removed it.
    """
    injected = dict(wrapper_env_pairs(content)).get("DYLD_INSERT_LIBRARIES", "")
    for path in injected.split(":"):
        if path and os.path.basename(path) == VR_GL_FIX_LIB:
            return path
    return None


def stack_search_dir(stack):
    """Where DYLD_LIBRARY_PATH points: the stack's lib/, or vr-lib in VR mode."""
    return stack.get("search_dir") or stack["prefix"] + "/lib"


def build_patch_values(prefix, glfw_path, icd_path, search_dir=None, preserved_flags=(), injected=()):
    """The four keys glmtlmc owns.

    search_dir defaults to the stack's lib/. preserved_flags are MoltenVR's own
    JvmArgs flags and injected the extra dylibs to add after libgl_interpose.dylib,
    both so a re-patch merges instead of overwriting.
    """
    search_dir = prefix + "/lib" if search_dir is None else search_dir
    jvm_flags = [
        "-Dorg.lwjgl.egl.libname=" + prefix + "/lib/libEGL.dylib",
        "-Dorg.lwjgl.opengl.libname=" + prefix + "/lib/libGL.dylib",
        "-Dorg.lwjgl.glfw.libname=" + glfw_path,
    ]
    jvm_flags.extend(preserved_flags)
    inserted = [search_dir + "/libgl_interpose.dylib"] + list(injected)
    return {
        "OverrideJavaArgs": "true",
        "JvmArgs": '"' + " ".join(jvm_flags) + '"',
        "OverrideCommands": "true",
        "WrapperCommand": ('"env DYLD_INSERT_LIBRARIES=' + ":".join(inserted)
                           + ' DYLD_LIBRARY_PATH=' + search_dir
                           + ' LIBGL_DRIVERS_PATH=' + prefix + '/lib/dri'
                           + ' VK_DRIVER_FILES=' + icd_path
                           + ' VK_ICD_FILENAMES=' + icd_path
                           + ' EGL_PLATFORM=surfaceless'
                           + ' MESA_LOADER_DRIVER_OVERRIDE=zink'
                           + ' MESA_GL_VERSION_OVERRIDE=4.6'
                           + ' MESA_GLSL_VERSION_OVERRIDE=460"'),
    }


def stack_paths(stack):
    prefix = stack["prefix"]
    paths = [
        os.path.join(prefix, "lib", "libEGL.dylib"),
        os.path.join(prefix, "lib", "libGL.dylib"),
        stack["glfw_path"],
        os.path.join(prefix, "lib", "libgl_interpose.dylib"),
        os.path.join(prefix, "lib"),
        os.path.join(prefix, "lib", "dri"),
        stack["icd_path"],
    ]
    search_dir = stack.get("search_dir")
    if search_dir:
        paths.append(search_dir)
        paths.extend(target for _, target in vr_link_targets(search_dir))
    paths.extend(stack.get("injected_libraries", ()))
    return paths


def vr_search_exclusion(name):
    """Why this image has to stay out of the VR search path, or None if it can go in.

    libGL.dylib loses its leaf-name race to Apple's OpenGL framework, and the
    GLFW fork is loaded by absolute path, so neither belongs there. Every other
    image in lib/ has a unique leaf name.
    """
    if name == "libGL.dylib":
        return "it would shadow the system OpenGL"
    if name.startswith("libglfw"):
        return "GLFW is loaded by absolute path"
    return None


def lib_image_names(prefix):
    """Every image in the stack's lib/, ordered by leaf name."""
    lib_dir = os.path.join(prefix, "lib")
    return sorted(name for name in os.listdir(lib_dir)
                  if os.path.isfile(os.path.join(lib_dir, name)))


def vr_link_names(prefix):
    """The images the VR search dir carries: every file in lib/ minus the two
    dyld could substitute for a system one."""
    return [name for name in lib_image_names(prefix)
            if not vr_search_exclusion(name)]


def vr_link_skips(prefix):
    """(name, reason) for each lib/ image that stays out of the VR search dir."""
    skipped = []
    for name in lib_image_names(prefix):
        reason = vr_search_exclusion(name)
        if reason:
            skipped.append((name, reason))
    return skipped


def vr_link_targets(vr_dir):
    """(name, resolved target) for each symlink in vr-lib."""
    return [(name, os.path.join(vr_dir, os.readlink(os.path.join(vr_dir, name))))
            for name in sorted(os.listdir(vr_dir))
            if os.path.islink(os.path.join(vr_dir, name))]


def link_vr_lib_entry(vr_dir, name):
    """Point one vr-lib entry at lib/; (verb, detail) for the change, else None.

    Relative links keep the directory valid if the prefix is moved, and a real
    file sitting at the name is left alone rather than clobbered.
    """
    path = os.path.join(vr_dir, name)
    target = os.path.join("..", "lib", name)
    if os.path.islink(path) and os.readlink(path) == target:
        return None
    if os.path.lexists(path) and not os.path.islink(path):
        return "left out", name + " (a real file is sitting there)"
    repaired = os.path.lexists(path)
    try:
        if repaired:
            os.remove(path)
        os.symlink(target, path)
    except OSError as failure:
        raise PhaseError("cannot write " + path + " (" + str(failure) + ") — "
                         + vr_dir + " must be writable for VR patching")
    return ("repaired" if repaired else "linked"), name + " -> " + target


def link_summary(placed, kept):
    """One row in place of the run of identical link results above it.

    Counts that came out at zero are left out rather than printed as a "0
    repaired" that implies work nobody did. A name that was left alone is not a
    link, so it never reaches the tally and is named in its own row instead.
    """
    counts = [(verb, placed.count(verb)) for verb in ("linked", "repaired")]
    parts = [str(count) + " " + verb for verb, count in counts if count]
    parts.append(str(kept) + " already in place")
    return ", ".join(parts)


def prepare_vr_search_dir(line, prefix):
    """<prefix>/vr-lib, a sibling of lib/ that mirrors it without libGL.

    Never moves or copies anything in lib/; falling back to lib/ here would
    reintroduce the exact collision VR patching exists to remove.
    """
    vr_dir = os.path.join(prefix, VR_LIB_NAME)
    if os.path.isdir(vr_dir):
        line.report("present", VR_LIB_NAME)
        return vr_dir
    try:
        os.makedirs(vr_dir, exist_ok=True)
    except OSError as failure:
        raise PhaseError("cannot create " + vr_dir + " (" + str(failure) + ") — "
                         "VR patching needs a writable stack prefix")
    line.report("created", VR_LIB_NAME)
    return vr_dir


