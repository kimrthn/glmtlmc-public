#!/usr/bin/env python3
"""glmtlmc — patch, unpatch, or update a Prism Launcher instance for the Mesa-zink stack."""

import glob
import json
import os
import platform
import subprocess
import sys
import threading
import time
from datetime import datetime

SPINNER_FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
SPINNER_INTERVAL = 0.08
PROBE_TIMEOUT = 20
INDENT = "  "

MINECRAFT_VERSION = "26.2"
STACK_KEYS = ("OverrideJavaArgs", "JvmArgs", "OverrideCommands", "WrapperCommand")

IS_TTY = sys.stdout.isatty()
RED = "\033[31m" if IS_TTY else ""
GREEN = "\033[32m" if IS_TTY else ""
RESET = "\033[0m" if IS_TTY else ""

ACTIVE_LINE = None


class PhaseError(Exception):
    """A phase failure with a message shown to the user."""


class PhaseLine:
    """One phase status line; animates a braille spinner while the work runs."""

    def __init__(self, title):
        global ACTIVE_LINE
        ACTIVE_LINE = self
        self.title = title
        self._stop = None
        if IS_TTY:
            sys.stdout.write(title + " ")
            sys.stdout.flush()
            self._spin_up()
        else:
            print(title)

    def _spin_up(self):
        self._stop = threading.Event()
        threading.Thread(target=self._animate, daemon=True).start()

    def _animate(self):
        index = 0
        while True:
            frame = SPINNER_FRAMES[index % len(SPINNER_FRAMES)]
            sys.stdout.write("\r" + self.title + " " + frame)
            sys.stdout.flush()
            if self._stop.wait(SPINNER_INTERVAL):
                break
            index += 1

    def detail(self, message):
        """Pause the spinner, print an indented detail line, resume."""
        if self._stop is None:
            print(INDENT + message)
            return
        self._stop.set()
        sys.stdout.write("\r\033[K")
        print(INDENT + message)
        self._spin_up()

    def _wind_down(self):
        global ACTIVE_LINE
        if self._stop is not None:
            self._stop.set()
            sys.stdout.write("\r\033[K")
            self._stop = None
        ACTIVE_LINE = None

    def done(self):
        """Persist the phase line on its own row."""
        if self._stop is not None:
            self._wind_down()
            print(self.title)

    def fail(self, reason):
        """Persist the phase line, then the indented error under it."""
        if self._stop is not None:
            self._wind_down()
            print(self.title)
        print(RED + INDENT + "error: " + reason + RESET)


def is_macho(path):
    macho_magics = (
        b"\xcf\xfa\xed\xfe", b"\xfe\xed\xfa\xcf",
        b"\xce\xfa\xed\xfe", b"\xfe\xed\xfa\xce",
        b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca",
    )
    with open(path, "rb") as handle:
        return handle.read(4) in macho_magics


def read_file_bytes(path):
    with open(path, "rb") as handle:
        return handle.read()


def write_atomically(path, content):
    temporary = path + ".glmtlmc.tmp"
    with open(temporary, "wb") as handle:
        handle.write(content)
    os.replace(temporary, path)


def strip_surrounding_quotes(text):
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        return text[1:-1]
    return text


def iter_key_values(content):
    """Yield (key, value) for each `key=value` line, split on the first `=`."""
    for line in content.decode("utf-8", "surrogateescape").splitlines():
        if line.lstrip().startswith(("[", "#")):
            continue
        key, separator, value = line.partition("=")
        if separator:
            yield key, value


def is_already_patched(content):
    for key, value in iter_key_values(content):
        if key == "WrapperCommand" and "libgl_interpose" in value \
                and "MESA_LOADER_DRIVER_OVERRIDE=zink" in value:
            return True
    return False


def general_section_bounds(lines):
    """(start, end) of the [General] section, end exclusive; None if missing."""
    start = None
    for index, line in enumerate(lines):
        if line.strip() == "[General]":
            start = index
            break
    if start is None:
        return None
    for index in range(start + 1, len(lines)):
        if lines[index].lstrip().startswith("["):
            return start, index
    return start, len(lines)


def find_key_line(lines, key, start, end):
    for index in range(start + 1, end):
        candidate, separator, _ = lines[index].partition("=")
        if separator and candidate.rstrip("\r") == key:
            return index
    return None


def last_key_line_index(lines, start, end):
    """Index of the last `key=value` line in the section; the header if none."""
    last = start
    for index in range(start + 1, end):
        line = lines[index]
        if "=" in line and not line.lstrip().startswith("#"):
            last = index
    return last


def line_ending(line):
    if line.endswith("\r\n"):
        return "\r\n"
    if line.endswith(("\n", "\r")):
        return line[-1:]
    return ""


def upsert_ini_keys(content, values):
    """Set each `key=value` inside [General], preserving every other byte."""
    lines = content.decode("utf-8", "surrogateescape").splitlines(keepends=True)
    for key, value in values.items():
        bounds = general_section_bounds(lines)
        if bounds is None:
            raise PhaseError("instance.cfg has no [General] section")
        start, end = bounds
        index = find_key_line(lines, key, start, end)
        if index is not None:
            lines[index] = key + "=" + value + line_ending(lines[index])
        else:
            anchor = last_key_line_index(lines, start, end)
            if not lines[anchor].endswith(("\n", "\r")):
                lines[anchor] += "\n"
            lines.insert(anchor + 1, key + "=" + value + "\n")
    return "".join(lines).encode("utf-8", "surrogateescape")


def remove_ini_keys(content, keys):
    """Drop every `key=value` line whose key is in `keys`; keep all else."""
    lines = content.decode("utf-8", "surrogateescape").splitlines(keepends=True)
    kept = []
    for line in lines:
        candidate, separator, _ = line.partition("=")
        if separator and candidate.rstrip("\r") in keys:
            continue
        kept.append(line)
    return "".join(kept).encode("utf-8", "surrogateescape")


def restore_ini_keys(current_content, backup_content):
    """Return current content with the 4 stack keys set to the backup state."""
    backup_values = dict(iter_key_values(backup_content))
    present = {key: backup_values[key] for key in STACK_KEYS if key in backup_values}
    absent = [key for key in STACK_KEYS if key not in backup_values]
    content = upsert_ini_keys(current_content, present)
    return remove_ini_keys(content, absent)


def resolve_mesa_prefix(script_dir):
    """Environment override, then the stack shipped next to the script, then ~/mesa-native."""
    explicit = os.environ.get("GLMTLMC_MESA_PREFIX")
    if explicit:
        return os.path.abspath(explicit)
    stack_prefix = os.path.join(script_dir, "stack")
    if os.path.isfile(os.path.join(stack_prefix, "lib", "libEGL.dylib")):
        return os.path.abspath(stack_prefix)
    return os.path.abspath(os.path.expanduser("~/mesa-native"))


def find_vulkan_icd(prefix):
    """First Vulkan ICD (sorted) whose library exists; (path, api_version) or None."""
    explicit = os.environ.get("GLMTLMC_ICD")
    if explicit:
        candidates = [explicit]
    else:
        candidates = sorted(glob.glob(
            os.path.join(prefix, "share", "vulkan", "icd.d", "*.json")))
    for candidate in candidates:
        try:
            with open(candidate, "r", encoding="utf-8") as handle:
                manifest = json.load(handle)
            library = manifest["ICD"]["library_path"]
            api_version = manifest["ICD"].get("api_version", "unknown")
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if not os.path.isabs(library):
            library = os.path.join(os.path.dirname(candidate), library)
        if os.path.isfile(library):
            return candidate, api_version
    return None


def find_glfw_dylib(script_dir):
    explicit = os.environ.get("GLMTLMC_GLFW_LIB")
    if explicit:
        candidates = [explicit]
    else:
        candidates = [
            os.path.join(script_dir, "stack", "lib", "libglfw.3.dylib"),
            os.path.join(script_dir, "..", "GL46-Exp", "glfw", "build", "src", "libglfw.3.dylib"),
            os.path.join(script_dir, "glfw", "build", "src", "libglfw.3.dylib"),
            os.path.join(script_dir, "..", "glfw", "build", "src", "libglfw.3.dylib"),
        ]
    for candidate in candidates:
        if os.path.isfile(candidate):
            return os.path.abspath(candidate)
    return None


def dequarantine(script_dir):
    """Strip Gatekeeper quarantine from the shipped stack and shaderpacks."""
    for folder in ("stack", "shaderpacks"):
        target = os.path.join(script_dir, folder)
        if os.path.isdir(target):
            subprocess.run(
                ["xattr", "-dr", "com.apple.quarantine", target],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def build_patch_values(prefix, glfw_path, icd_path):
    return {
        "OverrideJavaArgs": "true",
        "JvmArgs": ('"-Dorg.lwjgl.egl.libname=' + prefix + '/lib/libEGL.dylib'
                    + ' -Dorg.lwjgl.opengl.libname=' + prefix + '/lib/libGL.dylib'
                    + ' -Dorg.lwjgl.glfw.libname=' + glfw_path + '"'),
        "OverrideCommands": "true",
        "WrapperCommand": ('"env DYLD_INSERT_LIBRARIES=' + prefix + '/lib/libgl_interpose.dylib'
                           + ' DYLD_LIBRARY_PATH=' + prefix + '/lib'
                           + ' LIBGL_DRIVERS_PATH=' + prefix + '/lib/dri'
                           + ' VK_DRIVER_FILES=' + icd_path
                           + ' VK_ICD_FILENAMES=' + icd_path
                           + ' EGL_PLATFORM=surfaceless'
                           + ' MESA_LOADER_DRIVER_OVERRIDE=zink'
                           + ' MESA_GL_VERSION_OVERRIDE=4.6'
                           + ' MESA_GLSL_VERSION_OVERRIDE=460"'),
    }


def stack_paths(stack):
    prefix = stack["prefix"]
    return [
        os.path.join(prefix, "lib", "libEGL.dylib"),
        os.path.join(prefix, "lib", "libGL.dylib"),
        stack["glfw_path"],
        os.path.join(prefix, "lib", "libgl_interpose.dylib"),
        os.path.join(prefix, "lib"),
        os.path.join(prefix, "lib", "dri"),
        stack["icd_path"],
    ]


