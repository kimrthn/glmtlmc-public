def moltenvr_shim_dir():
    """Where MoltenVR drops its OpenVR shim; absent until VR is enabled once."""
    return os.path.expanduser("~/.moltenvr")


def require_moltenvr_shim(line):
    """MoltenVR's shim directory, proved to hold the library before it is named.

    LWJGL searches only the paths these flags give it, so a directory with no
    library in it is written into instance.cfg as a path that cannot resolve,
    and the launch then fails as "Failed to locate library", far from the cause.
    """
    shim_dir = moltenvr_shim_dir()
    shim_lib = os.path.join(shim_dir, MOLTENVR_SHIM_LIB)
    if not os.path.isfile(shim_lib):
        raise PhaseError(shim_lib + " not found — install MoltenVR, open it once, "
                         "press \"Enable VR\" on this instance, then run glmtlmc again")
    line.report("present", MOLTENVR_SHIM_LIB)
    # The binding is a second image in the same directory and "Enable VR" writes
    # both, so one without the other means a half-run step, not a broken install.
    lwjgl_lib = os.path.join(shim_dir, MOLTENVR_LWJGL_LIB)
    if not os.path.isfile(lwjgl_lib):
        raise PhaseError(lwjgl_lib + " not found — " + MOLTENVR_LWJGL_LIB + " is the LWJGL "
                         "OpenVR binding beside the shim, and \"Enable VR\" writes both; "
                         "press it on this instance, then run glmtlmc again")
    line.report("present", MOLTENVR_LWJGL_LIB)
    if " " in shim_dir:
        raise PhaseError("glmtlmc requires a space-free shim path (current: " + shim_dir + ")")
    return shim_dir


def with_moltenvr_flags(present_flags, shim_dir):
    """present_flags plus whichever of MoltenVR's three flags are missing.

    "Enable VR" is MoltenVR's own step and never guaranteed to have run on this
    instance, so glmtlmc adds what is absent rather than only preserving. A flag
    already present keeps its own value: it may name a shim the user built.
    """
    flags = list(present_flags)
    defaults = [prefix + shim_dir for prefix in MOLTENVR_PATH_FLAGS] + [MOLTENVR_ZGC_FLAG]
    for prefix, flag in zip(MOLTENVR_JVM_FLAGS, defaults):
        if not any(existing.startswith(prefix) for existing in flags):
            flags.append(flag)
    return flags


def moltenvr_library_dirs(tokens):
    """The directories a tokenised JvmArgs hands LWJGL for native library lookup."""
    return [token.partition("=")[2] for token in tokens
            if token.startswith(MOLTENVR_PATH_FLAGS)]


def moltenvr_app_version():
    """MoltenVR's bundle version, parsed out of Info.plist; None if unreadable.

    plistlib, not a grep: the value is one field in a plist that may be binary,
    and an absent bundle or a truncated file must both answer None instead of
    raising — the shim above is what the launch actually loads.
    """
    plist_path = os.path.join(MOLTENVR_APP, "Contents", "Info.plist")
    try:
        with open(plist_path, "rb") as handle:
            bundle = plistlib.load(handle)
    except (OSError, ValueError, ExpatError):
        return None
    if not isinstance(bundle, dict):
        return None
    return dotted_version(str(bundle.get("CFBundleShortVersionString", "")))


def report_moltenvr_install(line):
    """MoltenVR's own bundle, as far as the filesystem can prove it.

    Informational only. The shim is what the launch resolves, so an absent app, an
    unreadable plist, or a version older than MC 26.x needs is worth saying out
    loud and worth no halt on its own.
    """
    if not os.path.isdir(MOLTENVR_APP):
        line.detail("no MoltenVR.app in /Applications — the shim in " + moltenvr_shim_dir()
                    + " is what this needs, so patching continues")
        return
    version = moltenvr_app_version()
    if version is None:
        line.report("found", MOLTENVR_APP + " (its Info.plist version could not be read)")
        return
    line.report("found", "MoltenVR " + dotted_text(version) + " (" + MOLTENVR_APP + ")")
    if version < MOLTENVR_MIN_VERSION:
        line.detail("MoltenVR " + dotted_text(version) + " predates MC " + MINECRAFT_VERSION
                    + ": " + dotted_text(MOLTENVR_MIN_VERSION) + " or newer is required for the "
                    "LWJGL 3.4.1 dual librarypath install those versions ship with")


def run_vr_collision_probe(prefix, icd_path, search_dir, library_dirs):
    """Apple's OpenGL framework and Mesa's libGL must both survive one search
    path, and MoltenVR's shim must load once they do — its CGL symbols exist
    only in Apple's, which dyld substitutes away if the search path holds a
    libGL.dylib. library_dirs are the paths LWJGL would resolve the shim through."""
    snippet = VR_PROBE_CODE.replace("__PREFIX__", prefix)
    snippet = snippet.replace("__SHIM__", moltenvr_shim_dir())
    snippet = snippet.replace("__LIBRARY_DIRS__", repr(list(library_dirs)))
    try:
        completed = subprocess.run(
            [sys.executable, "-c", snippet],
            env=probe_environment(prefix, icd_path, search_dir),
            capture_output=True, text=True, timeout=PROBE_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise PhaseError("VR collision probe timed out after 20 seconds")
    if completed.returncode != 0:
        stderr = completed.stderr.strip()
        raise PhaseError(stderr if stderr
                         else "probe exited with code " + str(completed.returncode))
    return [line for line in completed.stdout.strip().splitlines() if line]


def verify_hardware(line):
