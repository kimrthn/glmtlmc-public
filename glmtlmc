def link_translation_layer(line, script_dir, stack):
    glfw_path = find_glfw_dylib(script_dir)
    if glfw_path is None:
        raise PhaseError("patched GLFW dylib not found (set GLMTLMC_GLFW_LIB)")
    if " " in glfw_path:
        raise PhaseError("glmtlmc requires a space-free path (current: " + glfw_path + ")")
    if not is_macho(glfw_path):
        raise PhaseError("not a Mach-O dylib: " + glfw_path)
    line.report("glfw", os.path.relpath(glfw_path, script_dir))
    stack["glfw_path"] = glfw_path


def instance_mods_dir(instance_dir):
    """Prism's mods folder for an instance; absent until the first mod install."""
    return os.path.join(instance_dir, "minecraft", "mods")


def mod_jar_names(mods_dir):
    """Jar names in mods_dir, or none at all when the folder cannot be read.

    A missing or unreadable folder is not a failure: an instance may never have
    had a mod, and detection must not be able to stop a patch.
    """
    try:
        names = os.listdir(mods_dir)
    except OSError:
        return []
    return [name for name in sorted(names) if name.lower().endswith(".jar")]


def dotted_version(text):
    """(major, minor, patch) for the first version in text; None when it has none.

    Also parses jar names, where the mod's own release is the first three-part run
    of digits: the Minecraft version that trails it is two parts
    (iris-fabric-1.11.4+26.2-fabric). A shorter run compares as the older release
    it is, which is the answer both callers want.
    """
    runs = DOTTED_VERSION.findall(text)
    if not runs:
        return None
    run = next((candidate for candidate in runs if candidate.count(".") == 2), runs[0])
    return tuple(int(piece) for piece in run.split("."))


def dotted_text(version):
    """The version as written, for a message that has to name it."""
    return ".".join(str(part) for part in version)


def find_mod_jars(mods_dir, mod_name):
    """(file name, version) for every jar of mod_name itself, oldest name first.

    The name has to be the mod's, and the segment after it must be a loader word
    or the version itself: otherwise the match is some other mod that merely
    shares the prefix, because sodium-extra is not Sodium.
    """
    jars = []
    for name in mod_jar_names(mods_dir):
        stem = name[:-4].lower()
        if not stem.startswith(mod_name):
            continue
        rest = stem[len(mod_name):]
        if rest and rest[0] not in "-_":
            continue
        head = rest.lstrip("-_").replace("_", "-").split("-")[0]
        if head and head not in MOD_LOADER_WORDS and head[0] not in DECIMAL_DIGITS:
            continue
        jars.append((name, dotted_version(stem)))
    return jars


def newest_mod_jar(jars):
    """The (file name, version) with the highest version in a find_mod_jars result.

    Fabric loads the highest jar present, so an older copy left in mods/ must not
    be the one that decides whether the shaders work.
    """
    return max(jars, key=lambda jar: jar[1])


def mod_jar_text(jar):
    """"<version> (<file name>)" for one find_mod_jars result."""
    filename, version = jar
    return dotted_text(version) + " (" + filename + ")" if version else filename


def injected_vr_libraries(line, content, stack):
    """The extra dylibs to insert after libgl_interpose.dylib, in order.

    A plain patch preserves what the instance already injects and never adds one:
    an instance that never carried the VR fix must stay byte-identical. A VR patch
    always points at the vr-lib copy it just built and measured, so an entry left
    over from another stack cannot hand dyld a library glmtlmc never checked.
    """
    preserved = preserved_vr_glfix(content)
    if stack.get("shim_dir") is None:
        return (preserved,) if preserved else ()
    local = os.path.join(stack_search_dir(stack), VR_GL_FIX_LIB)
    if preserved is not None and preserved != local:
        line.report("repointed", local + " (was " + preserved + ")")
    return (local,)


def inspect_shader_mods(line, instance_dir):
    """Iris and Sodium as this instance has them, before anything is written.

    Iris 1.11.3 reworked how it builds shader programs and the result in VR is a
    broken image in each eye view (IrisShaders/Iris issue #3373), which reads as a
    broken headset rather than as a shader bug, so the mismatch has to stop the
    run here instead of costing the user one.
    """
    mods_dir = instance_mods_dir(instance_dir)
    sodium = find_mod_jars(mods_dir, "sodium")
    if sodium:
        line.detail("Sodium " + mod_jar_text(newest_mod_jar(sodium)) + " — Iris "
                    + dotted_text(IRIS_SHADER_SAFE_VERSION) + " pairs with Sodium 0.9.1")
    iris = find_mod_jars(mods_dir, "iris")
    if not iris:
        line.detail("no Iris in " + mods_dir + " — VR runs, but no shaderpack can load")
        return
    for filename, version in iris:
        if version is not None:
            continue
        raise PhaseError("cannot read the Iris version in " + filename + " — VR needs Iris "
                         + dotted_text(IRIS_SHADER_SAFE_VERSION) + " or lower, so install that "
                         "version or rename the file to its usual form")
    newest = newest_mod_jar(iris)
    if newest[1] >= IRIS_SHADER_BREAK_VERSION:
        raise PhaseError(newest[0] + " is Iris " + dotted_text(newest[1]) + ": Iris "
                         + dotted_text(IRIS_SHADER_BREAK_VERSION) + " and newer break shaders "
                         "in the VR eye views (" + IRIS_ISSUE + ") — install Iris "
                         + dotted_text(IRIS_SHADER_SAFE_VERSION) + " or lower for VR")
    line.detail("Iris " + mod_jar_text(newest) + " — "
                + dotted_text(IRIS_SHADER_SAFE_VERSION) + " or lower, shaders keep working in VR")


def back_up_config(line, instance_dir, content):
    """Copy the config aside before a first patch, so unpatch has something to
    restore; a config glmtlmc already wrote is the backup of record."""
    if is_already_patched(content):
        line.detail("already patched, so the config on disk is the backup of record")
        return
    name = BACKUP_PREFIX + datetime.now().strftime(BACKUP_STAMP)
    with open(os.path.join(instance_dir, name), "wb") as handle:
        handle.write(content)
    line.report("backed up", name)


def configure_custom_arguments(line, instance_dir, stack):
    cfg_path = os.path.join(instance_dir, "instance.cfg")
    content = read_file_bytes(cfg_path)
    preserved = moltenvr_jvm_flags(content)
    shim_dir = stack.get("shim_dir")
    if shim_dir is not None:
        preserved = with_moltenvr_flags(preserved, shim_dir)
    stack["preserved_jvm_flags"] = preserved
    stack["injected_libraries"] = injected_vr_libraries(line, content, stack)
    values = build_patch_values(stack["prefix"], stack["glfw_path"], stack["icd_path"],
                                stack_search_dir(stack), preserved, stack["injected_libraries"])
    back_up_config(line, instance_dir, content)
    for verb, detail in set_verdicts(general_key_values(content), values):
        line.report(verb, detail)
    write_atomically(line, cfg_path, upsert_ini_keys(content, values))


def verify_startup(line, instance_dir, stack):
    values = build_patch_values(stack["prefix"], stack["glfw_path"], stack["icd_path"],
                                stack_search_dir(stack), stack["preserved_jvm_flags"],
                                stack["injected_libraries"])
    current = dict(iter_key_values(read_file_bytes(os.path.join(instance_dir, "instance.cfg"))))
    for key, expected in values.items():
        if current.get(key) != expected:
            raise PhaseError(key + " does not match the value written by glmtlmc")
    for path in stack_paths(stack):
        if not os.path.exists(path):
            raise PhaseError(path + " not found")
    line.report("checked", "instance.cfg holds the " + str(len(STACK_KEYS))
                + " stack keys and every stack path exists")


def prepare_vr_search_path(line, stack):
    """Mirror lib/ into vr-lib so DYLD_LIBRARY_PATH stops shadowing Apple's libGL,
    and pin MoltenVR's shim location for LWJGL to resolve the OpenVR library in.

    The shim is checked first: a missing one must fail before the config is
    written, not leave a JvmArgs pointing at a path with no library in it.
    """
    shim_dir = require_moltenvr_shim(line)
    line.report("found", shim_dir)
    report_moltenvr_install(line)
    prefix = stack["prefix"]
    vr_dir = prepare_vr_search_dir(line, prefix)
    for name, reason in vr_link_skips(prefix):
        line.report("left out", name + " (" + reason + ")")
    placed = []
    kept = 0
    for name in vr_link_names(prefix):
        note = link_vr_lib_entry(vr_dir, name)
        if note is None:
            kept += 1
            continue
        line.report(note[0], note[1])
        placed.append(note[0])
    line.detail(link_summary(placed, kept))
    stack["search_dir"] = vr_dir
    stack["shim_dir"] = shim_dir


def find_vr_glfix_source(script_dir):
    """vr_glfix.c from the repository the script ships in; None when it is absent."""
    for candidate in (os.path.join(script_dir, "scripts", VR_GL_FIX_SOURCE),
                      os.path.join(script_dir, "..", "scripts", VR_GL_FIX_SOURCE)):
        if os.path.isfile(candidate):
            return os.path.abspath(candidate)
    return None


def compile_vr_glfix(source, destination):
    """Build vr_glfix.c into destination; returns the compiler's warnings.

    OpenGL.framework has to be linked or dyld rejects the interpose tuples, and
    the result has to be signed or nothing will load it at all, so both ride in
    the one command rather than being left to the caller to remember.
    """
    command = ["xcrun", "clang", "-arch", "arm64", "-O2", "-Wall", "-Wextra", "-dynamiclib",
               "-install_name", "@rpath/" + VR_GL_FIX_LIB, "-framework", "OpenGL",
               source, "-o", destination]
    completed = run_tool(command, BUILD_TIMEOUT)
    if completed.returncode != 0:
        raise PhaseError("clang failed on " + source + " — "
                         + (completed.stderr.strip() or str(completed.returncode)))
    return [row for row in completed.stderr.splitlines() if row.strip()]


def sign_dylib(path):
    """Ad-hoc sign, which is what a dylib in the user's own stack needs to load."""
    completed = run_tool(["codesign", "--force", "--sign", "-", path])
    if completed.returncode != 0:
        raise PhaseError("codesign failed on " + path + " — "
                         + (completed.stderr.strip() or str(completed.returncode)))


def collapsed_or_wrong_table(size):
    """What an __interpose table of this size means, in words the user can act on.

    One tuple is the silent case: every trampoline took the name of the symbol it
    displaces, so each tuple is {self, self} and the library redirects nothing.
    """
    if size == INTERPOSE_TUPLE_BYTES:
        return ("one tuple is what a build emits when every trampoline took the name of the "
                "symbol it displaces, so the table loads and redirects nothing")
    return "the table is not the redirections the shim's imports need, so nothing is redirected"


def verify_vr_glfix(line, path):
    """Prove a libvr_glfix.dylib really redirects, before anything can load it.

    A build whose trampolines took the displaced symbols' own names produces a
    library that loads cleanly and does nothing at all, which is the failure
    these four checks keep out of a user's VR stack.
    """
    size = interpose_section_size(path)
    if size != VR_GL_FIX_INTERPOSE_BYTES:
        raise PhaseError(path + " has a " + str(size) + "-byte __interpose table, not "
                         + str(VR_GL_FIX_INTERPOSE_BYTES) + " (" + str(VR_GL_FIX_REDIRECTS)
                         + " tuples x 16) — " + collapsed_or_wrong_table(size))
    symbols = nm_symbols(path)
    redirects = [name for name, kind in symbols.items()
                 if kind == "T" and name.startswith("_redirect_gl")]
    if len(redirects) != VR_GL_FIX_REDIRECTS:
        raise PhaseError(path + " defines " + str(len(redirects)) + " redirect_gl* functions, "
                         "not " + str(VR_GL_FIX_REDIRECTS) + " — the shim's GL imports would "
                         "go unbound and segfault without a redirect")
    line.report("checked", "interpose table " + str(size) + " bytes, "
                + str(len(redirects)) + " redirects")
    cgl = [name for name, kind in symbols.items() if kind == "U" and name.startswith("_CGL")]
    if cgl:
        raise PhaseError(path + " binds " + ", ".join(sorted(cgl)) + " — Apple's CGL symbols "
                         "have to stay bound to the OpenGL framework, or the shim cannot "
                         "take the fallback path this library exists to make survivable")
    line.report("checked", "no Apple CGL symbols bound")
    if not is_code_signed(path):
        raise PhaseError(path + " is not code-signed — dyld will not load it")
    line.report("checked", "code signature present")


def install_vr_glfix(built, installed):
    """Put a verified build in place; the swap is atomic, so the path a launch
    would use is never a half-written dylib."""
    staged = installed + TEMP_SUFFIX
    shutil.copy2(built, staged)
    os.replace(staged, installed)


def deploy_vr_glfix(line, script_dir, stack):
    """The VR GL interposer, proved before it can reach the VR search path.

    libvr_glfix.dylib is the only thing between MoltenVR's shim and a null-CGL
    SIGSEGV, and a misbuilt one loads cleanly and does nothing, so it is compiled
    in a temporary directory, measured there, and only then copied into vr-lib.
    A failed build leaves nothing behind for the next run to find and trust.
    """
    vr_dir = stack["search_dir"]
    installed = os.path.join(vr_dir, VR_GL_FIX_LIB)
    if os.path.isfile(installed):
        try:
            verify_vr_glfix(line, installed)
        except PhaseError as broken:
            line.report("replacing", installed)
            line.detail(str(broken))
        else:
            line.report("kept", installed)
            return
    source = find_vr_glfix_source(script_dir)
    if source is None:
        raise PhaseError(VR_GL_FIX_SOURCE + " not found beside glmtlmc — VR patching builds "
                         + VR_GL_FIX_LIB + " from it")
    line.report("source", os.path.relpath(source, script_dir))
    build_dir = tempfile.mkdtemp(prefix=TEMP_BUILD_PREFIX)
    line.report("staged", build_dir)
    try:
        built = os.path.join(build_dir, VR_GL_FIX_LIB)
        for warning in compile_vr_glfix(source, built):
            line.detail("clang: " + warning)
        line.report("built", VR_GL_FIX_LIB)
        sign_dylib(built)
        line.report("signed", VR_GL_FIX_LIB + " (ad-hoc)")
        verify_vr_glfix(line, built)
        install_vr_glfix(built, installed)
        line.report("installed", installed)
    finally:
        shutil.rmtree(build_dir, ignore_errors=True)
        if os.path.isdir(build_dir):
            line.detail("could not remove " + build_dir)
        else:
            line.report("removed", build_dir)


def verify_moltenvr_flags(line, content):
    """The written JvmArgs, checked for the flags LWJGL resolves a library by.

    Reads instance.cfg back rather than re-deriving the value, so a write that
    lost or garbled a flag is caught here and not at launch as LWJGL's "Failed
    to locate library". Returns the library paths the flags name.
    """
    tokens = jvm_arg_tokens(content)
    for prefix in MOLTENVR_JVM_FLAGS:
        if not any(token.startswith(prefix) for token in tokens):
            raise PhaseError("JvmArgs lost " + prefix + " — LWJGL would search no path")
    library_dirs = moltenvr_library_dirs(tokens)
    for library_dir in library_dirs:
        shim_lib = os.path.join(library_dir, MOLTENVR_SHIM_LIB)
        if not os.path.isfile(shim_lib):
            raise PhaseError(shim_lib + " not found — JvmArgs points LWJGL at it")
    line.report("checked", "JvmArgs carries all " + str(len(MOLTENVR_JVM_FLAGS))
                + " MoltenVR flags, shim present in " + " and ".join(library_dirs))
    return library_dirs


def verify_vr_library_path(line, content, stack):
    """DYLD_LIBRARY_PATH must name vr-lib, and vr-lib must stay free of the two
    images dyld would substitute for a system one.

    libGL.dylib in that path shadows Apple's, which is what costs MoltenVR the
    CGL symbols its shim links against.
    """
    search_dir = dict(wrapper_env_pairs(content)).get("DYLD_LIBRARY_PATH")
    if search_dir != stack["search_dir"]:
        raise PhaseError("DYLD_LIBRARY_PATH is " + str(search_dir) + ", expected "
                         + stack["search_dir"])
    if os.path.basename(search_dir) != VR_LIB_NAME:
        raise PhaseError("DYLD_LIBRARY_PATH must name the " + VR_LIB_NAME
                         + " directory, not " + search_dir)
    shadowing = [name for name in os.listdir(search_dir) if vr_search_exclusion(name)]
    if shadowing:
        raise PhaseError(search_dir + " must not carry " + ", ".join(sorted(shadowing))
                         + " — dyld would substitute it for the system image")
    line.report("checked", "DYLD_LIBRARY_PATH is " + search_dir
                + ", carrying no libGL.dylib and no libglfw")


def verify_vr_startup(line, instance_dir, stack):
    """Mesa must still reach GL 4.6 through vr-lib, the config must tell LWJGL
    where MoltenVR's shim is, and that shim must load beside Mesa — the three
    ways this search dir has already failed."""
    prefix = stack["prefix"]
    for report_line in run_translation_probe(prefix, stack["icd_path"], stack["search_dir"]):
        line.detail(report_line)
    content = read_file_bytes(os.path.join(instance_dir, "instance.cfg"))
    library_dirs = verify_moltenvr_flags(line, content)
    verify_vr_library_path(line, content, stack)
    for report_line in run_vr_collision_probe(prefix, stack["icd_path"],
                                              stack["search_dir"], library_dirs):
        line.detail(report_line)


def do_nothing(line):
    pass


def verify_instance_state(line, instance_dir):
    cfg_path = os.path.join(instance_dir, "instance.cfg")
    if not is_already_patched(read_file_bytes(cfg_path)):
        raise PhaseError("instance is not patched")


def locate_backup(line, instance_dir, state):
    backups = glob.glob(os.path.join(instance_dir, BACKUP_PREFIX + "*"))
    if not backups:
        raise PhaseError("no backup found — cannot restore automatically")
    state["backup_path"] = max(backups)
    line.report("found", state["backup_path"])


def restore_configuration(line, instance_dir, state):
    """Put the 4 stack keys back from the backup, so a vr-lib WrapperCommand goes
    with them. vr-lib itself is left on disk: it is inert and rebuilt on demand."""
    cfg_path = os.path.join(instance_dir, "instance.cfg")
    backup_content = read_file_bytes(state["backup_path"])
    current_content = read_file_bytes(cfg_path)
    for verb, detail in restore_verdicts(current_content, backup_content):
        line.report(verb, detail)
    write_atomically(line, cfg_path, restore_ini_keys(current_content, backup_content))


def verify_vanilla_startup(line, instance_dir, state):
    cfg_path = os.path.join(instance_dir, "instance.cfg")
    current = dict(iter_key_values(read_file_bytes(cfg_path)))
    backup = dict(iter_key_values(read_file_bytes(state["backup_path"])))
    for key in STACK_KEYS:
        if current.get(key) != backup.get(key):
            raise PhaseError(key + " does not match the backup state")
    line.report("checked", "every stack key matches the backup")


def patch_phases(instance_dir, script_dir):
    stack = {}
    return [
        ("Verifying hardware compatibility", lambda line: verify_hardware(line)),
        ("Verifying instance version", lambda line: verify_instance_version(line, instance_dir)),
        ("Getting report from Translation Layer", lambda line: probe_report(line, script_dir, stack)),
        ("Configuring MESA", lambda line: configure_mesa(line, stack)),
        ("Configuring KosmikKrisp", lambda line: configure_kosmickrisp(line, stack)),
        ("Linking Translation Layer", lambda line: link_translation_layer(line, script_dir, stack)),
        ("Configuring Custom Arguments", lambda line: configure_custom_arguments(line, instance_dir, stack)),
        ("Verifying instance startup", lambda line: verify_startup(line, instance_dir, stack)),
        ("Cleaning up", do_nothing),
        ("Finalizing", do_nothing),
    ]


